# 非機密部署設定；複製為 .env 後再調整。
COMPOSE_PROJECT_NAME=linebot-document
APP_IMAGE=linebot-document:local
APP_PORT=8089
COMPANY_ID=company-local
PUBLIC_BASE_URL=https://document.example.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=linebot-document
ASSET_ARCHIVE_CODE_FORMATS=ZD#####,ZD#####@,ZD-JY#####,YJ######
SECRETS_DIR=./secrets
TUNNEL_ENABLED=false
CLOUDFLARED_PROTOCOL=http2
