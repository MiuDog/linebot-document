# ============================================================
# 環境變數範本
#
# 使用方式：複製成 .env 後填入實際值。
#   cp .env.example .env
#
# .env 已被 .gitignore 排除，絕對不要提交進版控。
# 本檔案（.env.example）只放說明與空白值，可以安全提交。
# ============================================================


# ------------------------------------------------------------
# LINE Messaging API
# 取得位置：LINE Developers Console → 你的 Channel
# ------------------------------------------------------------

# Messaging API 分頁 → Channel access token（長期）
LINE_BOT_CHANNEL_TOKEN=

# Basic settings 分頁 → Channel secret
LINE_BOT_CHANNEL_SECRET=

# 公司 VPN 或 Proxy 連線不穩時的等待上限；連線與完整請求分開控制。
LINE_CONNECT_TIMEOUT_SECONDS=10
LINE_REQUEST_TIMEOUT_SECONDS=30


# ------------------------------------------------------------
# 對外網址
# LINE 伺服器要靠這個網址回頭抓圖，必須是公開可存取的 HTTPS。
# 結尾不要帶斜線。
#
#   測試階段：填 ngrok 給的網址，例如 https://xxxx.ngrok-free.app
#             ngrok 免費版每次重啟都會換網址，記得同步更新這裡與 LINE Webhook 設定
#   部署階段：填公司伺服器的正式網域，例如 https://assets.example.com
# ------------------------------------------------------------
PUBLIC_BASE_URL=


# ------------------------------------------------------------
# 系統共同根目錄
#
# 這是唯一需要設定的本機檔案路徑。系統會自動建立：
#   {SYSTEM_ROOT_PATH}/圖片資產  圖片、待處理檔與 assets.db
#   {SYSTEM_ROOT_PATH}/log       執行記錄
#
# Docker Compose 會將這個主機路徑整體掛載到容器內，不必再分別設定子路徑。
# ------------------------------------------------------------
SYSTEM_ROOT_PATH=./system-data

# 客戶使用的資料夾代碼格式；# 代表一位數字，@ 代表一位大寫英文字母。
# 預設支援 ZD12345、ZD12345A、ZD-JY12345 與 YJ123456。
ASSET_ARCHIVE_CODE_FORMATS="ZD#####,ZD#####@,ZD-JY#####,YJ######"

# 後台同步腳本專用權杖，請填入一段無法猜測的長字串。
ASSETS_SYNC_TOKEN=

# 同步已改由 scripts/sync-assets.ps1 執行；通常保持 false。
ASSETS_SYNC_ENABLED=false


# ------------------------------------------------------------
# 流程追蹤
# 預設關閉；流程追蹤測試時才啟用，完成後關閉以避免大量方法 Log。
# ------------------------------------------------------------
METHOD_TRACING_ENABLED=false

# 日誌固定寫入 {SYSTEM_ROOT_PATH}/log。
LOG_LEVEL_ROOT=INFO
LOG_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=2GB
RESOURCE_LOG_INTERVAL_MS=60000


# ------------------------------------------------------------
# Ngrok（僅測試階段需要）
# 取得位置：https://dashboard.ngrok.com/get-started/your-authtoken
# 部署到公司伺服器後就不需要這一項，可把 compose 的 ngrok 服務關掉。
# ------------------------------------------------------------
NGROK_AUTHTOKEN=

# Cloudflare Tunnel 適合正式對外服務；公司 VPN 預設使用 TCP 7844 的 http2。
# Commercial 與 Document 必須各自建立 Tunnel，不可共用同一組 ID 與 Token。
CLOUDFLARE_ENABLED=false
CLOUDFLARE_AGENT_PATH=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PROTOCOL=http2
